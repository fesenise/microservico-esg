# Copie para .env e preencha localmente. Nunca envie .env ao GitHub.
# URL de exemplo: substitua pelo banco autorizado para este ambiente.
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
DB_USERNAME=preencher_usuario
DB_PASSWORD=preencher_senha
# Gere um segredo aleatorio, por exemplo: openssl rand -hex 32
JWT_SECRET=preencher_segredo_aleatorio_de_pelo_menos_32_caracteres
JWT_EXPIRATION=3600
# Para schema novo, mantenha false/0. Para schema existente, leia deploy/GUIA_AZURE.md.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=0
