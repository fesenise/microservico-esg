{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "nome",
      "email",
      "role"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1
      },
      "nome": {
        "type": "string",
        "minLength": 1
      },
      "email": {
        "type": "string",
        "format": "email"
      },
      "role": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  }
}
